# Ignore everything...
*
# ...but unignore any directory (so tracked subtrees stay reachable)...
!/**/
# ...and any file that has an extension.
# Net effect: extensionless compiled binaries (gustavo_options, H_min, delta,
# max_4u_*, ...) are ignored automatically, keeping `git status` clean.
!*.*

# Emacs/Vim swap & backup files.
*~
\#*#
*.swp
*.swo
*.swx

# Compiled files.
*.o
*.a
*.lo
*.la
*.mod

# Files generated by the build system (these carry extensions).
Makefile.in
config.h.in
config.h
config.status
config.log
aclocal.m4
*.Po
autom4te.cache/
config/
.deps/
.dirstamp
stamp-h1

# Data and graphics files.
bin
*.dat
*.out
*.ps
*.eps
*.pdf
*.png
*.gif

# VSCode.
.vscode/
